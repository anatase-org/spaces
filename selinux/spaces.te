policy_module(spaces, 1.0.0)

########################################
#
# Declarations
#

type spaces_exec_t;

type spaces_file_t;
container_file(spaces_file_t)
svirt_file_types(spaces_file_t)

type spaces_apifs_file_t;
container_file(spaces_apifs_file_t)
svirt_file_types(spaces_apifs_file_t)
term_pty(spaces_apifs_file_t)

type spaces_var_run_t;
files_pid_file(spaces_var_run_t)

type spaces_shortcut_t;
files_type(spaces_shortcut_t)

# The host-side supervisor is a container runtime, while the nspawn payload
# gets a separate, MCS-constrained container domain.
container_runtime_domain_template(spaces)
init_daemon_domain(spaces_t, spaces_exec_t)

gen_require(`
	attribute container_domain;
')
type spaces_container_t, container_domain;
domain_type(spaces_container_t)
domain_user_exemption_target(spaces_container_t)
mls_rangetrans_target(spaces_container_t)
mcs_constrained(spaces_container_t)
role system_r types spaces_container_t;

kernel_read_all_proc(spaces_container_t)
allow spaces_container_t spaces_file_t:file entrypoint;

virt_sandbox_net_domain(spaces_container_t)

########################################
#
# Spaces host supervisor
#

allow spaces_t self:fifo_file rw_fifo_file_perms;
allow spaces_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_lnk_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_fifo_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_sock_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_chr_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
manage_blk_files_pattern(spaces_t, spaces_file_t, spaces_file_t)
files_var_lib_filetrans(spaces_t, spaces_file_t, dir, "spaces")

# Exported desktop entries are the only host /usr content Spaces may modify.
manage_dirs_pattern(spaces_t, spaces_shortcut_t, spaces_shortcut_t)
manage_files_pattern(spaces_t, spaces_shortcut_t, spaces_shortcut_t)
manage_lnk_files_pattern(spaces_t, spaces_shortcut_t, spaces_shortcut_t)

manage_dirs_pattern(spaces_t, spaces_var_run_t, spaces_var_run_t)
manage_files_pattern(spaces_t, spaces_var_run_t, spaces_var_run_t)
manage_lnk_files_pattern(spaces_t, spaces_var_run_t, spaces_var_run_t)
manage_fifo_files_pattern(spaces_t, spaces_var_run_t, spaces_var_run_t)
manage_sock_files_pattern(spaces_t, spaces_var_run_t, spaces_var_run_t)
files_pid_filetrans(spaces_t, spaces_var_run_t, dir, "spaces")

# systemd-nspawn creates and mounts the API filesystem before it transitions
# the guest init process into spaces_container_t.
manage_dirs_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_lnk_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_fifo_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_sock_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_chr_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_blk_files_pattern(spaces_t, spaces_apifs_file_t, spaces_apifs_file_t)
allow spaces_t spaces_apifs_file_t:{ file dir } mounton;
allow spaces_t spaces_apifs_file_t:filesystem { mount remount unmount };

# systemd-nspawn uses setexeccon(3) for --selinux-context before it executes
# the container's init.
allow spaces_t self:process setexec;
allow spaces_t spaces_container_t:process transition;
allow spaces_t spaces_container_t:process { signal sigkill sigstop signull };
allow spaces_container_t spaces_t:process sigchld;
allow spaces_t spaces_container_t:process { noatsecure rlimitinh siginh };

corecmd_exec_bin(spaces_t)
corecmd_exec_shell(spaces_t)
files_read_etc_files(spaces_t)
kernel_mounton_kernel_sysctl(spaces_t)
miscfiles_read_localization(spaces_t)
selinux_get_enforce_mode(spaces_t)
auth_domtrans_chk_passwd(spaces_t)
systemd_login_watch_pid_dirs(spaces_t)
systemd_login_watch_session_dirs(spaces_t)
systemd_read_logind_sessions_files(spaces_t)
systemd_machined_watch_pid_dirs(spaces_t)
systemd_machined_read_pid_files(spaces_t)
init_create_pid_dirs(spaces_t)
init_delete_pid_dir_entry(spaces_t)
init_manage_pid_files(spaces_t)

# systemd-nspawn removes its per-machine directories below
# /run/systemd/nspawn during teardown.  The init policy has interfaces for
# creating those directories and removing their entries, but not for rmdir.
gen_require(`
	type init_var_run_t;
')
allow spaces_t init_var_run_t:dir rmdir;

optional_policy(`
	fprintd_dbus_chat(spaces_t)
')

# The per-user host portal broker connects to the initiating user's session
# bus and places its filtered proxy in a transient user scope.
gen_require(`
	attribute userdomain;
')
dbus_write_session_tmp_sock_files(spaces_t)
dbus_session_bus_client(spaces_t)
dbus_connect_session_bus(spaces_t)
allow spaces_t userdomain:system start;

########################################
#
# Spaces container payload
#

# Persistent state is relabeled only by the host.  The guest may manage and
# execute the restored spaces_file_t tree, but it cannot change SELinux
# labels or create that type on unrelated tmpfs mounts.
allow spaces_container_t spaces_file_t:dir_file_class_set map;
manage_dirs_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
exec_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_lnk_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_fifo_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_sock_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_chr_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
manage_blk_files_pattern(spaces_container_t, spaces_file_t, spaces_file_t)
allow spaces_container_t spaces_file_t:chr_file {
	mmap_file_perms watch watch_reads
};
allow spaces_container_t spaces_file_t:dir { watch watch_reads };
allow spaces_container_t spaces_file_t:fifo_file watch;
allow spaces_container_t spaces_file_t:{ file dir } mounton;
allow spaces_container_t spaces_file_t:filesystem { mount remount unmount };

# The guest systemd manages units within the cgroup subtree delegated by the
# host service.
fs_manage_cgroup_dirs(spaces_container_t)
fs_manage_cgroup_files(spaces_container_t)
fs_remount_cgroup(spaces_container_t)

# Runtime files created by guest systemd remain tmpfs_t.  Access them
# directly instead of transitioning them to the persistent spaces_file_t.
fs_manage_tmpfs_dirs(spaces_container_t)
fs_manage_tmpfs_files(spaces_container_t)
fs_manage_tmpfs_symlinks(spaces_container_t)
fs_manage_tmpfs_sockets(spaces_container_t)
fs_manage_tmpfs_chr_files(spaces_container_t)
fs_manage_tmpfs_blk_files(spaces_container_t)
fs_mounton_tmpfs(spaces_container_t)
allow spaces_container_t tmpfs_t:file execute;

# systemd builds mount namespaces and BPF filters for guest services.
dev_getattr_all_chr_files(spaces_container_t)
dev_mounton_sysfs(spaces_container_t)
dev_mount_sysfs_fs(spaces_container_t)
dev_remount_sysfs_fs(spaces_container_t)
dev_unmount_sysfs_fs(spaces_container_t)
fs_remount_tmpfs(spaces_container_t)
fs_unmount_tmpfs(spaces_container_t)
kernel_mount_proc(spaces_container_t)
kernel_unmount_proc(spaces_container_t)
kernel_mounton_all_proc(spaces_container_t)
kernel_mounton_all_sysctls(spaces_container_t)
kernel_mounton_kernel_sysctl(spaces_container_t)
term_mount_pty_fs(spaces_container_t)
allow spaces_container_t self:bpf {
	map_create map_read map_write prog_load prog_run
};

gen_require(`
	attribute domain;
	type cgroup_t;
	type container_runtime_tmpfs_t;
	type devpts_t;
	type device_t;
	type fixed_disk_device_t;
	type fonts_t;
	type hugetlbfs_t;
	type lvm_control_t;
	type mtrr_device_t;
	type proc_t;
	type proc_security_t;
	type rpc_pipefs_t;
	type sound_device_t;
	type sysctl_t;
	type tmpfs_t;
	type tty_device_t;
	type user_tty_device_t;
')
allow spaces_container_t cgroup_t:file mounton;
allow spaces_container_t devpts_t:chr_file mounton;
allow spaces_container_t device_t:filesystem { remount unmount };
# Newer container-selinux releases give some nspawn runtime tmpfs mounts a
# dedicated type.  Guest systemd must be able to populate those mounts.
manage_dirs_pattern(
	spaces_container_t,
	container_runtime_tmpfs_t,
	container_runtime_tmpfs_t
)
manage_files_pattern(
	spaces_container_t,
	container_runtime_tmpfs_t,
	container_runtime_tmpfs_t
)
manage_lnk_files_pattern(
	spaces_container_t,
	container_runtime_tmpfs_t,
	container_runtime_tmpfs_t
)
manage_fifo_files_pattern(
	spaces_container_t,
	container_runtime_tmpfs_t,
	container_runtime_tmpfs_t
)
manage_sock_files_pattern(
	spaces_container_t,
	container_runtime_tmpfs_t,
	container_runtime_tmpfs_t
)
# Explicit device binds and the service's dynamic cgroup policy decide which
# host devices enter a space.  SELinux must then permit those selected devices
# to function.
allow spaces_container_t fixed_disk_device_t:blk_file rw_blk_file_perms;
allow spaces_container_t lvm_control_t:chr_file rw_chr_file_perms;
allow spaces_container_t sound_device_t:chr_file rw_chr_file_perms;
allow spaces_container_t tty_device_t:chr_file open;
allow spaces_container_t user_tty_device_t:chr_file {
	open watch watch_reads
};
# Fontconfig and desktop applications watch the read-only font trees exported
# into graphical spaces.
allow spaces_container_t fonts_t:dir { watch watch_reads };
# Libvirt creates its QEMU hierarchy and backing files in the hugetlbfs
# mounted by systemd-nspawn at /dev/hugepages.
manage_dirs_pattern(spaces_container_t, hugetlbfs_t, hugetlbfs_t)
manage_files_pattern(spaces_container_t, hugetlbfs_t, hugetlbfs_t)
allow spaces_container_t hugetlbfs_t:filesystem { mount remount unmount };
# TODO: Restrict /proc/mtrr access once the guest hardware policy can
# distinguish the workloads that require it.
allow spaces_container_t mtrr_device_t:file { mounton write };
allow spaces_container_t proc_t:filesystem remount;
# These sysctls are host-global rather than namespaced.  Guest systemd may
# probe them, but a space must not change them.
dontaudit spaces_container_t proc_security_t:file write;
# Permit guest NFS services to mount their namespaced RPC pipe filesystem.
allow spaces_container_t rpc_pipefs_t:filesystem mount;
allow spaces_container_t sysctl_t:file mounton;
allow spaces_container_t tmpfs_t:file map;
# systemd falls back to bind-mounting standard device nodes onto regular
# tmpfs files when a service's capability bounding set excludes CAP_MKNOD.
allow spaces_container_t tmpfs_t:file mounton;
manage_fifo_files_pattern(spaces_container_t, tmpfs_t, tmpfs_t)
allow spaces_t domain:system status;

# An interactive entry inherits the caller's keyring, but the guest payload
# does not need to inspect it.
domain_dontaudit_search_all_domains_keyrings(spaces_container_t)

# systemd-nspawn labels its API filesystem directly with
# --selinux-apifs-context.  Grant the payload access explicitly instead of
# using container_manage_files_template(), because that helper would install
# a second, conflicting automatic transition for files created on tmpfs.
allow spaces_container_t spaces_apifs_file_t:dir_file_class_set {
	relabelfrom relabelto map
};
manage_dirs_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
exec_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_lnk_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_fifo_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_sock_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_chr_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
manage_blk_files_pattern(spaces_container_t, spaces_apifs_file_t, spaces_apifs_file_t)
allow spaces_container_t spaces_apifs_file_t:chr_file {
	mmap_file_perms watch watch_reads
};
allow spaces_container_t spaces_apifs_file_t:dir { watch watch_reads };
allow spaces_container_t spaces_apifs_file_t:fifo_file watch;
allow spaces_container_t spaces_apifs_file_t:sock_file watch;
allow spaces_container_t spaces_apifs_file_t:{ file dir } mounton;
allow spaces_container_t spaces_apifs_file_t:filesystem {
	mount remount unmount
};

# The guest PAM bridge connects back to the per-space host authentication
# socket.  Runtime portal sockets use this type as well.
allow spaces_container_t spaces_var_run_t:dir list_dir_perms;
allow spaces_container_t spaces_var_run_t:dir watch;
read_files_pattern(
	spaces_container_t,
	spaces_var_run_t,
	spaces_var_run_t
)
allow spaces_container_t spaces_var_run_t:sock_file rw_sock_file_perms;
allow spaces_container_t spaces_t:unix_stream_socket connectto;

# Desktop forwarding bind-mounts only the selected host display and media
# sockets into the guest mount namespace.  Permit the container to use those
# user-session sockets without exposing the rest of the host runtime tree.
gen_require(`
	type user_tmp_t;
	type config_home_t;
')
allow spaces_container_t user_tmp_t:file write;
allow spaces_container_t user_tmp_t:file map;
allow spaces_container_t config_home_t:file read_file_perms;
userdom_write_user_tmp_sockets(spaces_container_t)
xserver_stream_connect(spaces_container_t)
optional_policy(`
	unconfined_stream_connect(spaces_container_t)
	unconfined_use_fds(spaces_container_t)
')

# Electron and other Wayland clients use the explicitly exposed udmabuf
# device for graphics buffers and io_uring for their internal event loops.
dev_rw_dma_dev(spaces_container_t)
kernel_io_uring_use(spaces_container_t)

# Host-home paths are exposed only when the user selects them in a space's
# permissions and need write access.
userdom_manage_user_home_content(spaces_container_t)
userdom_exec_user_home_content_files(spaces_container_t)

# systemd-machined opens the container's /dev/ptmx when machinectl starts an
# interactive or command shell.
gen_require(`
	type systemd_machined_t;
	attribute user_home_type;
')
allow systemd_machined_t spaces_apifs_file_t:chr_file rw_chr_file_perms;
create_dirs_pattern(
	systemd_machined_t,
	spaces_apifs_file_t,
	spaces_apifs_file_t
)
create_files_pattern(
	systemd_machined_t,
	spaces_apifs_file_t,
	spaces_apifs_file_t
)
allow systemd_machined_t spaces_apifs_file_t:{ file dir } mounton;
allow systemd_machined_t spaces_file_t:{ file dir } mounton;
allow systemd_machined_t user_home_type:file getattr;
allow systemd_machined_t spaces_var_run_t:{ dir file sock_file } getattr;
userdom_search_user_home_content(systemd_machined_t)
