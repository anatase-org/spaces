# Maintainer: Antheas Kapenekakis <git@antheas.dev>

pkgname=spaces
pkgver=0.0.1
pkgrel=1
pkgdesc="Develop on the distribution of your choice, securely"
arch=('any')
url="https://github.com/anatase-org/spaces"
license=('AGPL-3.0-or-later')
depends=(
  'python'
  'python-rich'
  'python-textual'
  'polkit'
  'debootstrap'
  'ubuntu-keyring'
  'systemd'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
source=()
sha256sums=()

_project_dir="$PWD/.."

build() {
  cd "$_project_dir"
  /usr/bin/python -m build --wheel --no-isolation
}

# check() {
#   cd "$_project_dir"
#   PYTHONPATH=src /usr/bin/python -m unittest discover -s tests -v
# }

package() {
  cd "$_project_dir"
  /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 readme.md "$pkgdir/usr/share/doc/$pkgname/readme.md"
}
