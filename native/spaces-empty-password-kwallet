#!/bin/sh
set -eu

#
# Create an empty Blowfish wallet for a Spaces user. Guest accounts are
# deliberately locked and authenticated by the host, so there is no guest
# login password with which KWallet could protect or unlock its first wallet.
#

if \
    ! command -v gdbus >/dev/null 2>&1 ||
    ! command -v python3 >/dev/null 2>&1 ||
    ! test -x /usr/bin/ksecretd ||
    ! test -f /usr/share/dbus-1/services/org.kde.secretservicecompat.service
then
    exit 0
fi

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
kwalletrc="${config_home}/kwalletrc"

wallet="$(python3 - "${kwalletrc}" <<'PY'
import configparser
import sys

configuration = configparser.RawConfigParser(interpolation=None, strict=False)
configuration.optionxform = str
try:
    configuration.read(sys.argv[1], encoding="utf-8")
    enabled = configuration.get("Wallet", "Enabled", fallback="true")
    default = configuration.get(
        "Wallet",
        "Default Wallet",
        fallback="kdewallet",
    )
    wallet = configuration.get("Wallet", "Local Wallet", fallback=default)
except (configparser.Error, OSError, UnicodeError):
    raise SystemExit(1)
if enabled.lower() == "false" or not wallet or "/" in wallet:
    raise SystemExit(1)
print(wallet, end="")
PY
)" || exit 0

wallet_dir="${data_home}/kwalletd"
wallet_file="${wallet_dir}/${wallet}.kwl"
salt_file="${wallet_dir}/${wallet}.salt"

if [ -e "${wallet_file}" ]; then
    exit 0
fi

install -dm0700 "${wallet_dir}" "${config_home}"

password_hash="$(python3 - "${salt_file}" <<'PY'
import hashlib
import os
import sys

salt_path = sys.argv[1]
if os.path.exists(salt_path) and os.path.getsize(salt_path) == 56:
    with open(salt_path, "rb") as salt_file:
        salt = salt_file.read()
else:
    salt = os.urandom(56)
    descriptor = os.open(
        salt_path,
        os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
        0o600,
    )
    with os.fdopen(descriptor, "wb") as salt_file:
        salt_file.write(salt)

password_hash = hashlib.pbkdf2_hmac("sha512", b"", salt, 50000, 56)
print("[" + ", ".join(f"byte 0x{byte:02x}" for byte in password_hash) + "]")
PY
)"

gdbus call --session \
    --dest org.kde.secretservicecompat \
    --object-path /ksecretd \
    --method org.kde.KWallet.pamOpen \
    "${wallet}" "${password_hash}" 0 >/dev/null 2>&1 || exit 0
